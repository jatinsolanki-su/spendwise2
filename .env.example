# ==============================================================================
# SPENDWISE 2.0 ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and configure your environment.
# Variables are grouped into MANDATORY (required to start) and OPTIONAL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY: SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Application port and execution environment
NODE_ENV="development"
PORT="3000"

# Public application URL (used for CORS and self-referential links)
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. MANDATORY: AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Strong entropy secrets (minimum 32 chars for JWT_SECRET, 16 for COOKIE_SECRET).
# Generate cryptographically secure keys (e.g. using: openssl rand -hex 32)
JWT_SECRET="spendwise_prod_entropy_f48d91c78e63a56209b52a17cbef340e"
JWT_EXPIRES_IN="1d"
COOKIE_SECRET="spendwise_cookie_session_sign_key_91a0c4"

# ------------------------------------------------------------------------------
# 3. MANDATORY: MYSQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Connection parameters for your local or cloud MySQL 8.0+ instance.
# (If MySQL is temporarily offline, Spendwise automatically runs on its local
# relational engine in ./data to ensure zero downtime during development).
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_mysql_password_here"
DB_NAME="spendwise_db"

# ------------------------------------------------------------------------------
# 4. OPTIONAL: SMTP EMAIL DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# SMTP IS COMPLETELY OPTIONAL.
# The application starts and functions 100% normally without any SMTP variables.
# All features (registration, login, accounts, transactions, budgets, analytics)
# work without SMTP. Only email-based password reset uses SMTP if configured.
# If these variables are left blank or omitted, email delivery is gracefully disabled.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Spendwise <noreply@spendwise.app>"

# ------------------------------------------------------------------------------
# 5. OPTIONAL: AI STUDIO & EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
